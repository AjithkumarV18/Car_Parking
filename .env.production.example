COMPOSE_PROJECT_NAME=parking-management

# Public DNS and TLS paths. Do not include a protocol in SERVER_NAME.
SERVER_NAME=parking.example.com
CERTBOT_CERTS_DIR=./certbot/conf
CERTBOT_WEBROOT_DIR=./certbot/www

# MongoDB bootstrap credentials. Use long random, URI-safe values.
MONGO_INITDB_ROOT_USERNAME=parking_root
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-root-password
MONGO_INITDB_DATABASE=parking
MONGO_APP_USERNAME=parking_app
MONGO_APP_PASSWORD=replace-with-a-strong-app-password
