ENVIRONMENT=production
DEBUG=false
DOCS_ENABLED=false
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Set to the exact public origins served by Nginx.
BACKEND_CORS_ORIGINS=https://parking.example.com
ALLOWED_HOSTS=parking.example.com

# Compose injects MONGODB_URI and MONGODB_DATABASE using the least-privileged app account.
JWT_SECRET_KEY=replace-with-a-unique-64-character-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
