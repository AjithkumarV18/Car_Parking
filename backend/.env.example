# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
WEB_CONCURRENCY=1
DOCS_ENABLED=true
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB
MONGODB_URI=mongodb://admin:change-me-in-production@localhost:27017
MONGODB_DATABASE=parking

# JWT: replace with a high-entropy value before deployment
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
